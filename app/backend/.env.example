# Armoured Souls — Development Environment
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://armouredsouls:password@localhost:5432/armouredsouls
CORS_ORIGIN=
SCHEDULER_ENABLED=false
LOG_LEVEL=debug

# Image moderation starts automatically in acceptance and production. Development
# and test leave it off by default; set this to true only to test the model locally.
# When unavailable, custom image previews fail closed with 503.
# ENABLE_MODERATION=true

# JWT Configuration
# Secret key for signing JWTs. Use a strong random value (min 256 bits) in production.
JWT_SECRET=default-dev-secret
# Token lifetime (e.g. '24h', '7d'). Default: 24h
JWT_EXPIRATION=24h

# Finance report references use an independent key in production. Development
# falls back to a non-production constant only when this is unset.
# FINANCE_REPORT_REFERENCE_SECRET=replace-with-openssl-rand-hex-32

# Bcrypt Configuration
# Number of salt rounds for password hashing (default: 10)
# Higher values increase security but take longer to hash
# Recommended range: 10-12 for production
BCRYPT_SALT_ROUNDS=10

# Rate Limiting
# Auth endpoints use RATE_LIMIT_MAX_REQUESTS directly (default: 30/min).
# General API endpoints allow 10x that value (default: 300/min).
# Window duration in milliseconds. Default: 60000 (1 minute)
# RATE_LIMIT_WINDOW_MS=60000
# Max auth requests per window per IP. Default: 30
# RATE_LIMIT_MAX_REQUESTS=30
# Max economic endpoint requests per minute per authenticated user. Default: 100
# USER_ECONOMIC_RATE_LIMIT_MAX=100

# Scheduler Configuration
# Cron expressions for automated game cycle scheduling (daily slot map)
# LEAGUE_SCHEDULE=0 8 * * *
# TOURNAMENT_SCHEDULE=0 10 * * *
# TAGTEAM_SCHEDULE=0 11 * * *
# KOTH_SCHEDULE=0 13 * * *
# SETTLEMENT_SCHEDULE=0 0 * * *
# Reserved slots for future battle modes
# TEAM_2V2_LEAGUE_SCHEDULE=0 9 * * *
# TEAM_3V3_LEAGUE_SCHEDULE=0 14 * * *
# TEAM_2V2_TOURNAMENT_SCHEDULE=0 15 * * *
# TEAM_3V3_TOURNAMENT_SCHEDULE=0 18 * * *
# GRAND_MELEE_SCHEDULE=0 17 * * *

# Database pool and Automaton Turn_Step
# Backend pg pool cap (default 15); keep it below Postgres max_connections.
# DB_POOL_MAX=15
# Automaton turns run in parallel per Turn_Step (1-8, default 3; 1 = sequential).
# Keep 2 x concurrency + 5 <= DB_POOL_MAX; the runner clamps to that.
# AUTOMATON_TURN_CONCURRENCY=3
# Longest a Turn_Step keeps starting turns (ms, default 6 h); the only bound with the scheduler off.
# AUTOMATON_TURN_STEP_MAX_MS=21600000
# Stop starting turns this long before the next scheduled job (ms, default 15 min).
# AUTOMATON_TURN_STEP_SCHEDULE_MARGIN_MS=900000

# Monitoring & Alerting
# Discord webhook for ops alerts (disk, startup, backup, deploy failures).
# No fallback: without it, ops alerts are logged only (never sent to the player channel).
# MONITORING_DISCORD_WEBHOOK=
# Cron schedule for daily health report (default: 00:30 UTC, post-settlement)
# DAILY_REPORT_SCHEDULE=30 0 * * *
