{
  "name": "armoured-souls-backend",
  "version": "0.1.0",
  "description": "Backend for Armoured Souls Phase 1 Prototype",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc --project tsconfig.seed.json && cp -r src/content dist/content",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "gitnexus": "gitnexus",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "test": "jest --config jest.config.unit.js && jest --config jest.config.integration.js",
    "test:unit": "jest --config jest.config.unit.js",
    "test:unit:coverage": "jest --config jest.config.unit.js --coverage",
    "test:integration": "jest --config jest.config.integration.js",
    "test:heavy": "jest --config jest.config.heavy.js --forceExit",
    "test:tiers:verify": "tsx scripts/verifyTiers.ts",
    "test:all": "pnpm run test && pnpm run test:heavy",
    "test:matchmaking": "tsx scripts/testMatchmaking.ts",
    "test:robot-stats": "tsx scripts/testRobotStats.ts"
  },
  "keywords": [
    "game",
    "battle",
    "robot"
  ],
  "author": "Robert Teunissen",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "test-exclude": "^7.0.1",
      "tar": "7.5.21",
      "js-yaml": ">=4.2.0",
      "onnxruntime-node": "1.24.3",
      "adm-zip": "0.6.1",
      "brace-expansion@1.1.15": "1.1.18",
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.6",
      "ip-address": "10.3.1",
      "mysql2": "3.23.1",
      "qs": "6.16.0"
    },
    "onlyBuiltDependencies": [
      "@tensorflow/tfjs-node",
      "bcrypt",
      "esbuild",
      "sharp",
      "prisma",
      "@prisma/engines",
      "onnxruntime-node"
    ],
    "patchedDependencies": {
      "@tensorflow/tfjs-node@4.22.0": "patches/@tensorflow__tfjs-node@4.22.0.patch"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nsfwjs": "^4.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.10.2",
    "gitnexus": "^1.6.7",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
