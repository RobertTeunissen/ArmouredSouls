# Armoured Souls — Acceptance Environment
NODE_ENV=acceptance
PORT=3001
DATABASE_URL=postgresql://as_acc:CHANGE_ME@127.0.0.1:5432/armouredsouls_acc?connection_limit=10
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
CORS_ORIGIN=https://acc.armouredsouls.com
SCHEDULER_ENABLED=true
LEAGUE_SCHEDULE=0 8 * * *
TOURNAMENT_SCHEDULE=0 10 * * *
TAGTEAM_SCHEDULE=0 11 * * *
KOTH_SCHEDULE=0 13 * * *
SETTLEMENT_SCHEDULE=0 0 * * *
# Reserved slots for future battle modes
TEAM_2V2_LEAGUE_SCHEDULE=0 9 * * *
TEAM_3V3_LEAGUE_SCHEDULE=0 14 * * *
TEAM_2V2_TOURNAMENT_SCHEDULE=0 15 * * *
TEAM_3V3_TOURNAMENT_SCHEDULE=0 18 * * *
GRAND_MELEE_SCHEDULE=0 17 * * *
LOG_LEVEL=info
CHANGELOG_DEPLOY_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL

# --- Data retention
# battle_log playback JSON is ~180KB per battle and ACC produces ~7k battles/day,
# so the 7-day default holds ~9.5GB of live JSON and inflates every nightly
# pg_dump to ~4.5GB. Left at the default deliberately — playback across a full
# week is worth the space, and Spec #45 season rollover purges it wholesale.
# Lower this only as an emergency disk measure.
# BATTLE_LOG_RETENTION_DAYS=7
# audit_logs has no retention by default (opt-in). ACC prunes at 30 days.
AUDIT_LOG_RETENTION_DAYS=30
# Backup retention — 45GB disk, keep it lean
BACKUP_DAILY_RETAIN=2
BACKUP_WEEKLY_RETAIN=0

POSTGRES_USER=as_acc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=armouredsouls_acc

# Monitoring & Alerting
# Discord webhook for ops alerts (disk, startup, backup, deploy failures).
# Falls back to DISCORD_WEBHOOK_URL if not set.
# MONITORING_DISCORD_WEBHOOK=https://discord.com/api/webhooks/CHANGE_ME
# Cron schedule for daily health report (default: 00:30 UTC, post-settlement)
# DAILY_REPORT_SCHEDULE=30 0 * * *
