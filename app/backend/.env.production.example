# Armoured Souls — Production Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=production
PORT=3001

# Database (PostgreSQL via Docker)
DATABASE_URL=postgresql://as_prd:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/armouredsouls_prd
# Backend connection pool cap (default 15). Postgres allows max_connections=20;
# keep this at least 5 lower so deploys, backups and psql can still connect.
# (connection_limit in DATABASE_URL is ignored by the pg driver adapter.)
# DB_POOL_MAX=15
# Automaton turns run in parallel per Turn_Step (1-8, default 3; 1 = sequential).
# Keep 2 x concurrency + 5 <= DB_POOL_MAX; the runner clamps to that.
# AUTOMATON_TURN_CONCURRENCY=3
# Longest a Turn_Step keeps starting turns (ms, default 6 h); the only bound with the scheduler off.
# AUTOMATON_TURN_STEP_MAX_MS=21600000
# Stop starting turns this long before the next scheduled job (ms, default 15 min).
# AUTOMATON_TURN_STEP_SCHEDULE_MARGIN_MS=900000

# Authentication
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# REQUIRED: Independent report-reference key; never reuse the JWT signing key.
# Generate with: openssl rand -hex 32
FINANCE_REPORT_REFERENCE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# CORS — comma-separated explicit origins. Wildcards (*) are rejected at startup.
CORS_ORIGIN=https://armouredsouls.com,https://www.armouredsouls.com

# Scheduler
SCHEDULER_ENABLED=true
LEAGUE_SCHEDULE=0 8 * * *
TOURNAMENT_SCHEDULE=0 10 * * *
TAGTEAM_SCHEDULE=0 11 * * *
KOTH_SCHEDULE=0 13 * * *
SETTLEMENT_SCHEDULE=0 0 * * *
# Reserved slots for future battle modes
TEAM_2V2_LEAGUE_SCHEDULE=0 9 * * *
TEAM_3V3_LEAGUE_SCHEDULE=0 14 * * *
TEAM_2V2_TOURNAMENT_SCHEDULE=0 15 * * *
TEAM_3V3_TOURNAMENT_SCHEDULE=0 18 * * *
GRAND_MELEE_SCHEDULE=0 17 * * *
# Optional release label on Cycle Controls' "Backend restarted" markers.
# DEPLOY_TAG=

# Logging
LOG_LEVEL=info

# Image moderation starts automatically in production and acceptance. If it becomes
# unavailable, custom image previews fail closed with 503 rather than accepting unchecked uploads.

# Docker PostgreSQL credentials (used by docker-compose.production.yml)
POSTGRES_USER=as_prd
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=armouredsouls_prd

# Backup retention (defaults shown; MAINTENANCE.md "Backups"). Old dumps are
# deleted only after the new one is verified.
# BACKUP_DAILY_RETAIN=1
# BACKUP_PRE_DEPLOY_RETAIN=1
# BACKUP_WEEKLY_RETAIN=0

# Monitoring & Alerting
# Discord webhook for ops alerts (disk, startup, backup, deploy failures).
# No fallback: without it, ops alerts are logged only (never sent to the player channel).
# MONITORING_DISCORD_WEBHOOK=https://discord.com/api/webhooks/CHANGE_ME
# Cron schedule for daily health report (default: 00:30 UTC, post-settlement)
# DAILY_REPORT_SCHEDULE=30 0 * * *
