{
  "name": "armoured-souls-frontend",
  "version": "0.1.0",
  "description": "Frontend for Armoured Souls Phase 1 Prototype",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "katex": "^0.19.0",
      "dompurify": "3.4.17",
      "follow-redirects": "1.16.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.9",
      "undici@>=7.0.0 <7.30.1": "7.30.2"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts && tsc -p tsconfig.scripts.json",
    "icons:generate": "node scripts/generate-favicons.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ci": "vitest --run --reporter=dot --bail=5 --coverage --coverage.reporter=text-summary",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "playwright:report": "playwright show-report"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1"
  }
}
