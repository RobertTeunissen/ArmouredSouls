{
  "enabled": true,
  "name": "Review Database Migration",
  "description": "Review new database migrations for safety",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "app/backend/prisma/migrations/**/*.sql"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "New migration created. Review only that SQL file for data-loss risk, lock/performance impact, and rollback. Update docs/architecture/DATABASE_SCHEMA.md only if the schema changed significantly. Reply briefly."
  }
}