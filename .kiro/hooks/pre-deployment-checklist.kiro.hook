{
  "enabled": true,
  "name": "Pre-Deployment Checklist",
  "description": "Verify deployment readiness before pushing to main",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before pushing to main (which triggers ACC deployment), verify against `git diff main...HEAD --stat` only: 1) Tests for the changed areas pass, 2) No console.log in changed production code, 3) New environment variables documented, 4) New migrations tested, 5) Docs updated. Report a short pass/fail list."
  }
}