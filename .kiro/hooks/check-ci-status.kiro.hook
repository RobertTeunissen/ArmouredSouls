{
  "enabled": true,
  "name": "Check CI Status",
  "description": "Fetches the latest GitHub Actions workflow run status and failure details for the current branch, so the agent can see CI results without manual copy-pasting.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run this command to check CI status: `gh run list --branch $(git branch --show-current) --limit 1 --json status,conclusion,name,databaseId` If it passed or is still running, report that and stop. On failure, run `gh run view {databaseId} --log-failed | grep -iE 'error|fail|✕|expected|received' | head -n 80` (widen to `| tail -n 150` only if that is not enough). Fix the root cause."
  }
}