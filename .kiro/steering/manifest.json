{
  "version": 1,
  "maxAlwaysLines": 95,
  "maxLines": {
    "always": 50,
    "fileMatch": 220,
    "auto": 120,
    "manual": 550
  },
  "maxBytes": {
    "always": 4000,
    "fileMatch": 14000,
    "auto": 6000,
    "manual": 20000
  },
  "modeBudgets": {
    "always": {
      "maxAggregateLines": 95,
      "maxAggregateBytes": 7000
    },
    "manual": {
      "maxAggregateLines": 400,
      "maxAggregateBytes": 30000
    }
  },
  "manualBudgets": {
    ".kiro/steering/environments-and-deployment.md": { "maxLines": 120, "maxBytes": 10000 },
    ".kiro/steering/git-workflow.md": { "maxLines": 100, "maxBytes": 6000 },
    ".kiro/steering/monitoring-observability.md": { "maxLines": 80, "maxBytes": 5000 },
    ".kiro/steering/performance-guidelines.md": { "maxLines": 80, "maxBytes": 5000 },
    ".kiro/steering/common-tasks.md": { "maxLines": 80, "maxBytes": 4000 },
    ".kiro/steering/pre-deployment-checklist.md": { "maxLines": 70, "maxBytes": 4000 }
  },
  "overlapBudgets": {
    "maxMatchedFiles": 5,
    "maxAggregateLines": 160,
    "maxAggregateBytes": 13000
  },
  "representativePaths": [
    { "name": "backend-route", "path": "app/backend/src/routes/auth.ts" },
    { "name": "backend-economy-service", "path": "app/backend/src/services/economy/repairService.ts" },
